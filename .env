# Docker Settings
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# HUGGING-FACE SETTINGS
HF_ENDPOINT=https://hf-mirror.com

# DATA SETTINGS
DATA_DIR=/data
DATA_SPLIT_DIR=/workspace/logs/data_split
GRPO_TRAIN_RATE=0.6
GRPO_VAL_RATE=0.1
SFT_TRAIN_RATE=0.25
SFT_VAL_RATE=0.05
TEST_RATE=0.4                  # 对于不划分训练集和测试集的数据，先按这个比例划分出测试集

# MODEL SETTINGS
PRM_DIR=/models/qwen2.5-1.5b-prm
PRM_SAVE=/models/qwen2.5-1.5b-prm-finetuned

BASEMODEL_DIR=/models/qwen2.5-1.5b-prm
REF_SAVE=/models/qwen2.5-1.5b-sft-finetuned
GRPO_SAVE=/models/qwen2.5-1.5b-cppo-result-only
CHECKPOINT_DIR=checkpoint-400
