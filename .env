# Docker Settings
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# HUGGING-FACE SETTINGS
HF_ENDPOINT=https://hf-mirror.com

# DATA SETTINGS
DATA_DIR=/data
DATA_SPLIT_DIR=/workspace/logs/data_split
GRPO_TRAIN_RATE = 0.6
GRPO_VAL_RATE = 0.1
SFT_TRAIN_RATE = 0.25
SFT_VAL_RATE = 0.05
TEST_RATE = 0.4                  # 对于不划分训练集和测试集的数据，先按这个比例划分出测试集

GSM8K_DIR=/data/GSM8K
MATH_DIR=/data/MATH
CMATH_DIR=/data/CMATH
DEEPMATH_103K_DIR=/data/DEEPMATH-103K

# REWARD MODEL SETTINGS
PRM_MODEL_NAME=Qwen/Qwen2.5-1.5B
PRM_MODEL_PATH=/models/prm
PRM_PRETRAINED_MODEL_PATH=/models/prm/pretrained
PRM_MODEL_LOGS_DIR=/workspace/logs/prm